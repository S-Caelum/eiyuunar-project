// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id       String @id @default(auto()) @map("_id") @db.ObjectId
  username String @unique
  password String

  profile Profile?
}

model Profile {
  id   String @id @default(auto()) @map("_id") @db.ObjectId
  tag  String
  name String

  characters Character[]

  user   User   @relation(fields: [userID], references: [id])
  userID String @unique @db.ObjectId
}

model Character {
  id          String @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  alias       String
  description String

  gender   Gender @relation(fields: [genderID], references: [id])
  genderID String @db.ObjectId

  race   Race   @relation(fields: [raceID], references: [id])
  raceID String @db.ObjectId

  birthday DateTime

  maxHealth    Int
  health       Int
  maxMana      Int
  mana         Int
  wayre        Int
  speed        Int
  actionsCount Int

  martial   Martial @relation(fields: [martialID], references: [id])
  martialID String  @db.ObjectId
  magic     Magic   @relation(fields: [magicID], references: [id])
  magicID   String  @db.ObjectId

  skills   Skill[]  @relation(fields: [skillIDs], references: [id])
  skillIDs String[] @db.ObjectId

  stat   StatBlock @relation(fields: [statID], references: [id])
  statID String    @db.ObjectId

  owner   Profile @relation(fields: [ownerID], references: [id])
  ownerID String  @db.ObjectId

  inventory   Inventory @relation(fields: [inventoryID], references: [id])
  inventoryID String    @db.ObjectId

  equipment   Equipment @relation(fields: [equipmentID], references: [id])
  equipmentID String    @db.ObjectId
}

model Gender {
  id         String      @id @default(auto()) @map("_id") @db.ObjectId
  name       String
  characters Character[]
}

model Race {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  description String
  icon        String?
  effects     Effect[] @relation(fields: [effectIDs], references: [id])
  effectIDs   String[] @db.ObjectId

  Character Character[]
}

model StatBlock {
  id           String @id @default(auto()) @map("_id") @db.ObjectId
  vitality     Int
  constitution Int
  speed        Int
  reaction     Int
  academics    Int
  wisdom       Int

  character Character[]
}

model Martial {
  id         String @id @default(auto()) @map("_id") @db.ObjectId
  name       String
  experience Int

  characters Character[]
}

model Magic {
  id         String @id @default(auto()) @map("_id") @db.ObjectId
  name       String
  experience Int

  characters Character[]
}

model Skill {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  description String
  type        SkillType
  cost        Int

  effect    Effect[] @relation(fields: [effectIDs], references: [id])
  effectIDs String[] @db.ObjectId

  characters   Character[] @relation(fields: [characterIDs], references: [id])
  characterIDs String[]    @db.ObjectId
}

model Effect {
  id          String @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  description String

  duration    Int?
  maxStacks   Int?
  isStackable Boolean @default(false)

  skill    Skill[]  @relation(fields: [skillIDs], references: [id])
  skillIDs String[] @db.ObjectId

  components   EffectComponent[] @relation(fields: [componentIDs], references: [id])
  componentIDs String[]          @db.ObjectId

  weapons       Weapon[]     @relation(fields: [weaponIDs], references: [id])
  weaponIDs     String[]     @db.ObjectId
  armors        Armor[]      @relation(fields: [armorIDs], references: [id])
  armorIDs      String[]     @db.ObjectId
  consumables   Consumable[] @relation(fields: [consumableIDs], references: [id])
  consumableIDs String[]     @db.ObjectId
  Race          Race[]       @relation(fields: [raceIDs], references: [id])
  raceIDs       String[]     @db.ObjectId
}

model EffectComponent {
  id       String         @id @default(auto()) @map("_id") @db.ObjectId
  target   String
  value    Int
  modifier EffectModifier

  effects   Effect[] @relation(fields: [effectIDs], references: [id])
  effectIDs String[] @db.ObjectId
}

model Inventory {
  id     String          @id @default(auto()) @map("_id") @db.ObjectId
  owners Character[]
  items  InventoryItem[]
}

model InventoryItem {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  inventory   Inventory @relation(fields: [inventoryId], references: [id])
  inventoryId String    @db.ObjectId
  item        Item      @relation(fields: [itemId], references: [id])
  itemId      String    @db.ObjectId
  count       Int
}

model Equipment {
  id   String @id @default(auto()) @map("_id") @db.ObjectId
  item Item[]

  character Character[]
}

model Item {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  name          String
  item_type     ItemType
  description   String
  weight        Float
  general_price Int

  armor      Armor?
  weapon     Weapon?
  consumable Consumable?

  inventories InventoryItem[]
  Equipment   Equipment?      @relation(fields: [equipmentID], references: [id])
  equipmentID String?         @db.ObjectId
}

model Armor {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  bodyPart   BodyPart
  durability Int
  effects    Effect[] @relation(fields: [effectIDs], references: [id])
  effectIDs  String[] @db.ObjectId
  item       Item     @relation(fields: [itemID], references: [id])
  itemID     String   @unique @db.ObjectId
}

model Weapon {
  id         String     @id @default(auto()) @map("_id") @db.ObjectId
  type       WeaponType
  durability Int

  baseDamage      Int?
  falloffDistance Float?

  effects   Effect[] @relation(fields: [effectIDs], references: [id])
  effectIDs String[] @db.ObjectId
  item      Item     @relation(fields: [itemID], references: [id])
  itemID    String   @unique @db.ObjectId
}

model Consumable {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  effects   Effect[] @relation(fields: [effectIDs], references: [id])
  effectIDs String[] @db.ObjectId
  item      Item     @relation(fields: [itemID], references: [id])
  itemID    String   @unique @db.ObjectId
}

enum EffectModifier {
  ABSOLUTE
  PERCENTAGE
  MULTIPLIER
}

enum ActionType {
  USE_ATTACK
  USE_SKILL
  USE_ITEM
}

enum SkillType {
  MAGICAL
  MARTIAL
}

enum ItemType {
  WEAPON
  ARMOR
  CONSUMABLE
  OTHER
}

enum WeaponType {
  MELEE
  RANGED_STANDART
  RANGED_GUN
  CATALYST
}

enum BodyPart {
  HEAD
  CHEST
  LHAND
  RHAND
  STOMACH
  LLEG
  RLEG
  SIGNET
}
